# Nymbl Workspace - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED: Database
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nymbl

# =============================================================================
# REQUIRED: Session Security
# =============================================================================
# Random string for session encryption (generate with: openssl rand -hex 32)
SESSION_SECRET=your-random-session-secret-at-least-32-characters

# =============================================================================
# OPTIONAL: Microsoft SSO (Azure AD / Entra ID)
# =============================================================================
# To enable Microsoft sign-in, register an app in Azure Portal:
# 1. Go to Azure Portal > App registrations > New registration
# 2. Set redirect URI to: https://your-domain/api/auth/microsoft/callback
# 3. Create a client secret under Certificates & secrets

# Application (client) ID from Azure Portal
MICROSOFT_CLIENT_ID=

# Client secret VALUE (not the secret ID!)
MICROSOFT_CLIENT_SECRET=

# Directory (tenant) ID, or "common" for any Microsoft account
MICROSOFT_TENANT_ID=common

# =============================================================================
# OPTIONAL: Server Configuration
# =============================================================================
# Port to run the server on (default: 5000)
PORT=5000

# Environment mode (development or production)
NODE_ENV=production
