# prodCo Workspace - Environment Template
# Duplicate this file to .env and configure values.

# Firestore Database (Local Emulator configuration defaults)
# =============================================================================
FIREBASE_PROJECT_ID=demo-projectmgmt
FIRESTORE_EMULATOR_HOST=127.0.0.1:8082

# Session Security (Required)
# =============================================================================
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production

# Server Configuration
# =============================================================================
PORT=8080
NODE_ENV=development

# OPTIONAL: Microsoft SSO
# =============================================================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# OPTIONAL: Google OAuth
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
